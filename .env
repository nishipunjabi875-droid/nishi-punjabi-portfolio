# Target Website Configurations
BASE_URL=https://www.woodenstreet.com

# Playwright Settings
HEADLESS=true
BROWSER=chromium
TIMEOUT=60000
PARALLEL_WORKERS=4

# Crawl Limit for Link Checker (scale to 1000+ for deep audits, 50 for quick check)
MAX_CRAWL_PAGES=50

# Mock Authentication Credentials (can be updated for real authentication)
LOGIN_USER=test_user@woodenstreet.com
LOGIN_PASS=TestPassword123
